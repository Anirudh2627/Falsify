# Falsify environment configuration -- copy to .env and fill in.
# All variables are OPTIONAL: missing values degrade gracefully
# (no Tavily key -> UNVERIFIABLE results; no LLM key -> deterministic pipeline).

# --- Evidence retrieval (Tavily) -------------------------------------------
TAVILY_API_KEY=

# --- LLM (any OpenAI-compatible endpoint: Nebius AI Studio, NVIDIA NIM,
#     OpenAI, vLLM, Together, ...) -------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Nebius AI Studio example:
#   LLM_BASE_URL=https://api.studio.nebius.cloud/v1
#   LLM_MODEL=meta-llama/llama-3.1-70b-instruct
# (NEBIUS_API_KEY is also accepted as an alias for LLM_API_KEY)
