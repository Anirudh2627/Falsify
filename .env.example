# Falsify Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# All variables are OPTIONAL: missing provider credentials degrade gracefully
# (no Tavily key -> fallback mock/unverifiable; no LLM key -> deterministic heuristic pipeline).

# --- Server & Operational Settings ------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Directory containing compiled frontend static assets for unified single-container deployment.
# In production containers, set to /app/frontend/dist. Leave empty or unset in backend-only dev mode.
STATIC_DIR=frontend/dist

# Allowed CORS origins as a comma-separated list or JSON array.
# For production same-origin deployment, "*" or your production domain can be used.
# Example: https://falsify.example.com,https://app.example.com
CORS_ORIGINS=*

# Maximum request payload size in bytes (default: 1048576 = 1MB).
# Protects against large body memory exhaustion attacks.
MAX_REQUEST_SIZE_BYTES=1048576

# Request rate limiting (requests per minute per client IP). 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=0

# --- Database Persistence (SQLite / SQLAlchemy) -----------------------------
# Local development:
DATABASE_URL=sqlite:///./falsify.db

# Docker / Container persistent volume path:
# DATABASE_URL=sqlite:////app/data/falsify.db

# --- Evidence Retrieval (Tavily Search API) ---------------------------------
# Get your API key at: https://tavily.com
# If unset, offline/in-memory retrieval is used during tests and demo runs.
TAVILY_API_KEY=

# --- Language Model (OpenAI-compatible endpoints) ---------------------------
# Supported providers: OpenAI, Nebius AI Studio, Together, NVIDIA NIM, vLLM, etc.
# If unset, Falsify operates in deterministic offline heuristic mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Nebius AI Studio Example:
#   LLM_BASE_URL=https://api.studio.nebius.cloud/v1
#   LLM_MODEL=meta-llama/llama-3.1-70b-instruct
#   (NEBIUS_API_KEY is also accepted as an alias for LLM_API_KEY)
