# Frontend Environment Configuration
#
# Development Mode (Vite dev server with proxy):
# Leave empty or set to http://localhost:8000.
#
# Production Same-Origin / Unified Container:
# Leave empty: VITE_API_BASE_URL=
# (All API calls will use relative paths like /api/verify against the same origin).
#
# Split Deployment (e.g. Frontend on Vercel/Cloudflare Pages, Backend on Fly.io/Render):
# Set to your full backend domain (without trailing slash):
# VITE_API_BASE_URL=https://falsify-api.fly.dev
#
# IMPORTANT: Never place API keys, private credentials, or secrets in this file.
# Vite prefixes are bundled into client-side JavaScript.
VITE_API_BASE_URL=
